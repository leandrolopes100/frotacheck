DJANGO_SECRET_KEY=sua-chave-secreta-longa-e-aleatoria-aqui

# ── Banco de dados (PostgreSQL) ──────────────────────────────────────────────
# Sem essas variáveis, os valores padrão abaixo são usados (úteis só para
# um Postgres local já configurado com esses mesmos dados). Crie o
# banco/usuário antes de rodar as migrations pela primeira vez, por exemplo:
#   CREATE USER frotacheck WITH PASSWORD 'sua-senha' CREATEDB;
#   CREATE DATABASE frotacheck OWNER frotacheck ENCODING 'UTF8';
DB_NAME=frotacheck
DB_USER=frotacheck
DB_PASSWORD=sua-senha-aqui
DB_HOST=localhost
DB_PORT=5432

# ── E-mail de alerta de avaria ──────────────────────────────────────────────
# Sem essas variáveis, os e-mails de avaria não são enviados (a view simplesmente
# não tenta). Enquanto EMAIL_HOST_USER estiver vazio ou não for definido, o
# backend cai no padrão de console (django.core.mail.backends.console.EmailBackend)
# e os e-mails só são impressos no terminal, não são entregues de verdade.
#
# Exemplo com Gmail: gere uma "Senha de App" em
# https://myaccount.google.com/apppasswords (exige verificação em 2 etapas
# ativada na conta) — a senha normal da conta NÃO funciona via SMTP.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=senha-de-app-de-16-digitos
DEFAULT_FROM_EMAIL=FrotaCheck <seu-email@gmail.com>
EMAIL_TIMEOUT=10
